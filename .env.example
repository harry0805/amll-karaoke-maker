# Public browser project token, never a personal API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Local development sends no analytics unless explicitly enabled.
VITE_POSTHOG_ENABLED=false
# Public contact email sent to lrc.red in X-Client-ID; required for lyric search.
VITE_LRC_RED_CONTACT_EMAIL=
