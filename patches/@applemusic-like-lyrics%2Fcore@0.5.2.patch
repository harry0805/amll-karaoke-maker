+    for (const entry of entries) pending.set(entry.target, entry);
+    if (!frame) frame = requestAnimationFrame(() => {
+      frame = 0;
+      const batch = Array.from(pending.values());
+      pending.clear();
+      if (batch.length) callback(batch, observer);
+    });
+  });
+  const unobserve = observer.unobserve.bind(observer);
+  observer.unobserve = (target) => { pending.delete(target); unobserve(target); };
+  const disconnect = observer.disconnect.bind(observer);
+  observer.disconnect = () => {
+    if (frame) cancelAnimationFrame(frame);
+    frame = 0;
+    pending.clear();
+    disconnect();
+  };
+  return observer;
